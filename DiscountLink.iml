      <excludeFolder url="file://$MODULE_DIR$/mobile/.idea" />
      <excludeFolder url="file://$MODULE_DIR$/mobile/build" />
      <excludeFolder url="file://$MODULE_DIR$/mobile/.pub" />
    </content>
    <orderEntry type="sourceFolder" forTests="false" />
  </component>
</module>
